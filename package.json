    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.22.0",
    "dotenv": "^16.6.1",
    "fastmcp": "^3.23.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
