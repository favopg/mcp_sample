{
  "name": "mcp_asobi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MCP server sandbox written in TypeScript",
  "license": "MIT",
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
